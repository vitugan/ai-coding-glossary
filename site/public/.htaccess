# Apache (Fornex cPanel hosting). HTTPS is terminated by Cloudflare, so there
# is no http→https redirect here (it would loop behind "Flexible" SSL).

ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Site root → a language: the reader's earlier choice (cookie set by the
  # site), else Ukrainian if the browser accepts it, else English for any
  # other browser language, else Ukrainian.
  RewriteCond %{HTTP_COOKIE} (^|;\s*)lang=(uk|en)(;|$)
  RewriteRule ^$ /%2/ [R=302,L]
  RewriteCond %{HTTP:Accept-Language} (^|[\s,])uk [NC]
  RewriteRule ^$ /uk/ [R=302,L]
  RewriteCond %{HTTP:Accept-Language} .
  RewriteRule ^$ /en/ [R=302,L]
  RewriteRule ^$ /uk/ [R=302,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Fingerprinted build assets never change under the same name.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <Else>
    Header set Cache-Control "public, max-age=300"
  </Else>
</IfModule>
