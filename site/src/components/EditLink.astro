---
// "Edit this page" + "Report a problem" (pre-filled GitHub issue).
import { Icon } from "@astrojs/starlight/components";
import { REPO } from "../site.ts";
import { t } from "./labels.ts";

const { editUrl, entry, locale, isFallback } = Astro.locals.starlightRoute;
const labels = t(locale);
const isTerm = !!entry.data.term;
const issueUrl =
  `${REPO}/issues/new?title=` +
  encodeURIComponent(`[${locale ?? "en"}] ${entry.data.title}: `);
---

<div class="links sl-flex print:hidden">
  {
    editUrl && !isFallback && (
      <a href={editUrl} class="sl-flex">
        <Icon name="pencil" size="1.2em" />
        {Astro.locals.t("page.editLink")}
      </a>
    )
  }
  {
    isTerm && (
      <a href={issueUrl} class="sl-flex">
        <Icon name="warning" size="1.2em" />
        {labels.report}
      </a>
    )
  }
</div>

<style>
  .links {
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
  }
  a {
    gap: 0.5rem;
    align-items: center;
    text-decoration: none;
    color: var(--sl-color-gray-3);
  }
  a:hover {
    color: var(--sl-color-white);
  }
</style>
